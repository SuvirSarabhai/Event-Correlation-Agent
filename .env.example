# ── Database ───────────────────────────────────────────────────────────────────
# CockroachDB Serverless connection string (from cockroachlabs.cloud console)
COCKROACHDB_URL=postgresql+psycopg2://REPLACE_USER:REPLACE_PASS@REPLACE_HOST.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# ── Gemini ─────────────────────────────────────────────────────────────────────
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY
